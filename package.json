{
	"name": "puzzle-gems",
	"type": "module",
	"version": "0.0.1",
	"main": "desktopApp.js",
	"scripts": {
		"build": "vite build",
		"build-desktop-app": "vite build && electron-builder",
		"dev": "vite",
		"preview": "vite preview",
		"zip": "npm run build && mkdir -p dist && zip -r dist/game.zip dist -x \"**/.DS_Store\""
	},
	"dependencies": {
		"kaplay": "^4000.0.0-alpha.27.1"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"electron": "^43.3.0",
		"electron-builder": "^26.15.3",
		"vite": "^8.1.3"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"optionalDependencies": {
		"@rolldown/binding-linux-x64-gnu": "^1.2.1"
	},
	"build": {
		"appId": "com.raphaklaus.puzzleGems",
		"files": [
			"dist/**/*",
			"desktopApp.js"
		],
		"win": {
			"target": "portable"
		}
	}
}